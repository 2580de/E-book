# Bookhub local environment template
# Copy to .env.local for local development. Never commit .env.local.
#
# Browser-safe values (these are public/publishable, protected by Supabase RLS).
VITE_SUPABASE_URL="https://esuoeumgwafsmylkcqdy.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY"
# Legacy anon-key fallback supported by supabaseClient.js:
VITE_SUPABASE_ANON_KEY=""

# Server-side PostgreSQL connections only. Never prefix these with VITE_.
# Encode special password characters for URL use (for example $ becomes %24).
# IMPORTANT: replace the password placeholder; do not commit real credentials.
# Supavisor transaction pooler for app runtime (IPv4-compatible, port 6543).
DATABASE_URL="postgresql://postgres.esuoeumgwafsmylkcqdy:YOUR_URL_ENCODED_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Supavisor session pooler for Prisma CLI schema introspection/migrations (port 5432).
DIRECT_URL="postgresql://postgres.esuoeumgwafsmylkcqdy:YOUR_URL_ENCODED_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
