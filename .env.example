# Bookhub environment template
# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials.
#
# Browser-safe values only. These are intentionally empty until configured.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Prisma server-side PostgreSQL connections.
# DATABASE_URL: Supabase shared transaction-mode pooler (IPv4-friendly, port 6543).
# DIRECT_URL: Supabase shared session-mode pooler (used for Prisma migrations/introspection).
# Replace placeholders with the connection strings shown in Supabase Dashboard > Connect.
# Do not expose either variable through VITE_* or client-side JavaScript.
DATABASE_URL=""
DIRECT_URL=""
