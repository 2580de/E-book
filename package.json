{
  "name": "bookhub",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bookhub — a fast, personalized discovery platform for books, audiobooks, video books and articles.",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:pull": "prisma db pull --config prisma.config.ts",
    "db:sync": "npm run db:pull && npm run db:generate",
    "db:validate": "prisma validate --config prisma.config.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "dotenv": "^17.2.2",
    "prisma": "^7.10.0",
    "vite": "^7.0.0"
  }
}
