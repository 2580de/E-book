{
  "name": "bookhub",
  "version": "3.0.0",
  "private": true,
  "description": "Bookhub — personalized discovery for books, audiobooks, video books and articles.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:pull": "prisma db pull --config prisma.config.ts",
    "db:sync": "npm run db:pull && npm run db:generate",
    "db:validate": "prisma validate --config prisma.config.ts"
  },
  "engines": { "node": ">=22.0.0" },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.16.3",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.2.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^7.10.0",
    "typescript": "^5.9.2"
  }
}