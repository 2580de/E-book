# Copy this file to .env.local and fill in your real values.

# --- Supabase client (used by js/supabaseClient.js in the browser) ---
# Project Settings -> API
SUPABASE_URL=https://esuoeumgwafsmylkcqdy.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Prisma (used server-side only — scripts, migrations, future API) ---
# Project Settings -> Database -> Connection string
# Transaction-mode pooler (IPv4-only, port 6543) — used at runtime by Prisma Client
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler (port 5432) — used for migrations only
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
