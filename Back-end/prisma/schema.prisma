generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Supabase Auth owns auth.users. Profile IDs reference auth.users UUIDs;
// Prisma models only the application-owned public schema.
model Profile {
  id                 String         @id @db.Uuid
  username           String?        @unique @db.VarChar
  fullName           String?        @map("full_name")
  avatarUrl          String?        @map("avatar_url")
  selectedCategories String[]       @default([]) @map("selected_categories")
  selectedFormats    String[]       @default([]) @map("selected_formats")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  bookmarks          Bookmark[]
  activities         UserActivity[]

  @@map("profiles")
}

model Book {
  id            String     @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  title         String    @db.VarChar
  author        String    @db.VarChar
  description   String?
  category      String    @db.VarChar
  format        String    @default("ebook") @db.VarChar
  coverImageUrl String?   @map("cover_image_url")
  contentUrl    String?   @map("content_url")
  publishedYear Int?      @map("published_year")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  bookmarks     Bookmark[]

  @@map("books")
}

model Article {
  id        String     @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  title     String    @db.VarChar
  author    String?   @db.VarChar
  content   String
  category  String?   @db.VarChar
  imageUrl  String?   @map("image_url")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  bookmarks Bookmark[]

  @@map("articles")
}

model Bookmark {
  id        String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String?  @map("book_id") @db.Uuid
  articleId String?  @map("article_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("bookmarks")
}

model UserActivity {
  id           BigInt   @id @default(autoincrement())
  userId       String   @map("user_id") @db.Uuid
  activityType String   @map("activity_type") @db.VarChar
  targetType   String?  @map("target_type") @db.VarChar
  targetId     String?  @map("target_id") @db.Uuid
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profile      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activity")
}
