generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Supabase Auth owns auth.users. This model maps only the public profile table.
model Profile {
  id                 String   @id @db.Uuid
  username           String?  @unique
  fullName           String?  @map("full_name")
  avatarUrl          String?  @map("avatar_url")
  selectedCategories String[] @default([]) @map("selected_categories")
  selectedFormats    String[] @default([]) @map("selected_formats")
  createdAt          DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  @@map("profiles")
}

model Book {
  id             String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  title          String
  author         String
  description    String?
  category       String
  format         String   @default("ebook")
  coverImageUrl  String?  @map("cover_image_url")
  contentUrl     String?  @map("content_url")
  publishedYear  Int?     @map("published_year")
  createdAt      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  @@map("books")
}

model Article {
  id        String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  title     String
  author    String?
  content   String
  category  String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  @@map("articles")
}

model Bookmark {
  id        String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String?  @map("book_id") @db.Uuid
  articleId String?  @map("article_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")
  @@index([userId])
  @@index([bookId])
  @@index([articleId])
  @@map("bookmarks")
}

model UserSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  sessionToken  String?   @unique @map("session_token")
  deviceLabel   String?   @map("device_label")
  ipAddress     String?   @map("ip_address")
  cookieConsent Json      @default("{}") @map("cookie_consent")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  expiresAt     DateTime? @map("expires_at")
  @@map("user_sessions")
}

model UserCache {
  userId     String   @map("user_id") @db.Uuid
  cacheKey   String   @map("cache_key")
  cacheValue Json     @map("cache_value")
  updatedAt  DateTime @default(now()) @map("updated_at")
  expiresAt  DateTime @default(dbgenerated("(now() + interval '30 days')")) @map("expires_at")
  @@id([userId, cacheKey])
  @@map("user_cache")
}

model UserActivity {
  id           BigInt   @id @default(autoincrement())
  userId       String?  @map("user_id") @db.Uuid
  activityType String   @map("activity_type")
  targetType   String?  @map("target_type")
  targetId     String?  @map("target_id") @db.Uuid
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  @@map("user_activity")
}

model UserData {
  userId    String   @map("user_id") @db.Uuid
  dataKey   String   @map("data_key")
  dataValue Json     @default("{}")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@id([userId, dataKey])
  @@map("user_data")
}