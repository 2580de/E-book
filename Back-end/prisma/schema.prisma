generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Supabase Auth owns auth.users. Prisma models the public application
// tables and keeps auth-owned UUIDs as scalar fields.

model Profile {
  id                 String   @id @db.Uuid
  selectedCategories String[] @map("selected_categories")
  selectedFormats    String[] @map("selected_formats")
  @@map("profiles")
}

model Book {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  author    String?
  category  String?
  format    String?
  coverUrl  String?  @map("cover_url")
  blurb     String?
  @@map("books")
}

model Article {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  kind        String?
  publishedAt DateTime @default(now()) @map("published_at")
  url         String?
  @@map("articles")
}

model UserSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  sessionToken  String?   @unique @map("session_token")
  deviceLabel   String?   @map("device_label")
  ipAddress     String?   @map("ip_address")
  cookieConsent Json      @default("{}") @map("cookie_consent")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  expiresAt     DateTime? @map("expires_at")
  @@map("user_sessions")
}

model UserCache {
  userId     String   @map("user_id") @db.Uuid
  cacheKey   String   @map("cache_key")
  cacheValue Json     @map("cache_value")
  updatedAt  DateTime @default(now()) @map("updated_at")
  expiresAt  DateTime @default(dbgenerated("(now() + interval '30 days')")) @map("expires_at")
  @@id([userId, cacheKey])
  @@map("user_cache")
}

model UserActivity {
  id           BigInt   @id @default(autoincrement())
  userId       String?  @map("user_id") @db.Uuid
  activityType String   @map("activity_type")
  targetType   String?  @map("target_type")
  targetId     String?  @map("target_id") @db.Uuid
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  @@map("user_activity")
}

model UserData {
  userId    String   @map("user_id") @db.Uuid
  dataKey   String   @map("data_key")
  dataValue Json     @map("data_value")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@id([userId, dataKey])
  @@map("user_data")
}
